# Konfigurace appky. Zkopíruj jako .env a vyplň hodnoty.
# (.env se necommituje do gitu — je v .gitignore)
#
# Na Renderu se tyhle hodnoty nezadávají do souboru, ale do Environment Variables.
# Podrobný postup, kde co vzít, je v NASAZENI.md.
#
# Bez klíče k dané službě se appka nerozbije — jen tu část tiše vypne a napíše to do logu.

# Port, na kterém appka poběží. Na Renderu ho dodává platforma, nevyplňuj ho tam.
PORT=3000

# --- Solax (střídač FVE) — bez tohohle nemá appka smysl ---
SOLAX_TOKEN_ID=
SOLAX_SN=

# --- Shelly (relé: bojler, bazén, solinátor, světla) ---
SHELLY_AUTH_KEY=
SHELLY_SERVER_URI=
SHELLY_DEVICE_ID=
POOL_DEVICE_ID=
SOLINATOR_DEVICE_ID=
# volitelně, jinak se použije SHELLY_SERVER_URI:
# POOL_SERVER_URI=
# SOLINATOR_SERVER_URI=

# Nástěnná čidla Shelly H&T — podle nich (a NE podle čidla v klimatizaci, které visí
# u stropu) se řídí teplotní automatika toho pokoje. Všechna mají v kódu výchozí hodnotu
# ukazující na PŮVODNÍ čidla — vyplň svoje Device ID (Shelly appka → zařízení →
# Settings → Device information → Device Id). Pokoj bez čidla jede podle klimatizace.
# SHELLY_TEMP_OBYVAK_ID=
# SHELLY_TEMP_LOZNICE_ID=
# SHELLY_TEMP_ELENKA_ID=
# SHELLY_TEMP_MIKY_ID=

# --- Panasonic klimatizace + tepelné čerpadlo (Comfort Cloud) ---
PANASONIC_EMAIL=
PANASONIC_PASSWORD=
# Verzi mobilní appky Panasonic si server zjišťuje sám; vyplň, jen kdyby přestal.
# PANASONIC_APP_VERSION=

# --- TaHoma / Somfy (žaluzie) ---
TAHOMA_EMAIL=
TAHOMA_PASSWORD=

# --- Solax wallbox ---
WALLBOX_SN=

# --- Asistent (Claude) ---
ANTHROPIC_API_KEY=

# --- Nuki zámek ---
NUKI_TOKEN=
# Nevyplněné = vezme se první zámek na účtu
# NUKI_SMARTLOCK_ID=

# --- Infigy (bojler 2, výkon wallboxu, odhad výroby) ---
# POZOR: INFIGY_SUPABASE_REF a INFIGY_DEVICE_ID mají v kódu výchozí hodnoty, které
# ukazují na PŮVODNÍ instalaci. Když je nevyplníš, appka čte cizí zařízení.
INFIGY_EMAIL=
INFIGY_PASSWORD=
INFIGY_DEVICE_ID=
INFIGY_SUPABASE_REF=
INFIGY_SUPABASE_ANON=

# --- Počasí (volitelné, ale doporučené) ---
# Bez klíče nejede korekce podle západu slunce ani teplotní přirážka solinátoru.
OWM_API_KEY=
# Souřadnice tvého domu (bez nich se použije původní místo v ČR)
WEATHER_LAT=
WEATHER_LON=

# --- Kapacita baterie v kWh (řídí korekci prahů podle předpovědi výroby) ---
BATTERY_KWH=11.6

# --- Push notifikace (volitelné) ---
# Pár klíčů vygeneruješ příkazem:  npx web-push generate-vapid-keys
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:tvuj@email.cz

# --- Kamna HUUM (UKU WiFi) — jen čtení teploty a stavu (volitelné) ---
# Stejné jméno a heslo jako do mobilní appky HUUM. Bez nich jsou karty na stránce
# Sauna prázdné (náhled). Viz SAUNA.md.
HUUM_USER=
HUUM_PASS=
# Adresa API — měnit jen kdyby ji HUUM přestěhoval
HUUM_URL=

# --- Trvalé úložiště (doporučené) ---
# Bez něj se historie, doby běhu i měsíční spotřeby ztratí při každém nasazení.
# Zdarma na upstash.com: vytvoř Redis databázi a zkopíruj REST URL a REST token.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Prefix klíče — měň jen když do jedné databáze ukládá víc instalací (výchozí "solax")
STORE_PREFIX=

# POZOR: APP_PIN nic nedělá — zamykání appky je v kódu natvrdo vypnuté (server.js).
# RENDER_EXTERNAL_URL nenastavuj, Render ji dodává sám (drží službu vzhůru).
